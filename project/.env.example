# ── Variables d'environnement LCAPP ──────────────────────────────
# Copier ce fichier en .env pour le développement local :
#   cp .env.example .env
# puis remplir les valeurs depuis Supabase → Project Settings → API.
# NE JAMAIS committer le .env (déjà ignoré dans .gitignore).

# URL du projet Supabase (ex. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clé publique "anon" du projet Supabase
VITE_SUPABASE_ANON_KEY=
